# ============================================================================
# JAMB Quiz — environment variables
# Copy to `.env.local` and fill in the real values.
# ============================================================================

# --- Turso database (production) -------------------------------------------
# Create with:  turso db create jamb-quiz && turso db tokens create
# TURSO_DATABASE_URL accepts a libsql:// or turso:// URL.
TURSO_DATABASE_URL=libsql://your-project.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Local development ------------------------------------------------------
# Set TURSO_DATABASE_URL to a file: URL to use a local SQLite/libSQL file
# instead of Turso. Leave the auth token blank.
# TURSO_DATABASE_URL=file:./dev.db

# --- Admin Secret Key -------------------------------------------------------
# Secret key to unlock /admin dashboard.
ADMIN_KEY=921d41819e9e90fde2e21521c8e4279d

# --- UTME Lab question API --------------------------------------------------
# The question bank lives in the UTME Lab API, not in this app's database.
# Base URL includes the version prefix; no trailing slash.
UTMELAB_API_URL=https://api.utmelab.com/api/v1
# Server-only API key (sent as the `x-api-key` header). Never expose it to the
# browser, and never prefix it with NEXT_PUBLIC_.
UTMELAB_API_KEY=your-utmelab-api-key
# Exam code to serve. JAMB is the only code with full question depth today.
UTMELAB_EXAM=JAMB
